NODE_ENV=development
PORT=8000
# Neon: paste the pooled connection URL from your Neon project here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Comma-separated browser origins. Mobile clients do not use browser CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Optional Cloudinary URL (keep private; only needed for uploads).
CLOUDINARY_URL=
